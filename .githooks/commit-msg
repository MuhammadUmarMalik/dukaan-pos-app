#!/bin/sh
# Conventional Commits check. Enable with: npm run setup
msg=$(head -n1 "$1")
case "$msg" in
  Merge\ *|Revert\ *|fixup!*|squash!*) exit 0 ;;
esac
if ! printf '%s' "$msg" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .{1,72}$'; then
  echo "Commit message must follow Conventional Commits, for example:" >&2
  echo "  feat(sell): add weight entry" >&2
  echo "  fix(db): reject duplicate reversal" >&2
  echo "Types: feat fix docs style refactor perf test build ci chore revert (see docs/git-workflow.md)" >&2
  exit 1
fi
