# Copy to .env (git-ignored). Firebase console > Project settings > Your apps > Web app > Config.
# These identify the project and are public. Data is protected by Firestore Security Rules and App Check.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_APP_ID=
# Google sign-in (Google Cloud > Credentials; one OAuth client ID per platform you ship):
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# NEVER put a service-account key or admin credentials here.
